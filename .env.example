# =============================================================================
# VayuSaathi — Environment Configuration (.env.example)
# Copy to .env.local for local development. Never commit real secrets.
# =============================================================================

# LLM Provider Configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_ENABLED=true

# Air Quality Provider (waqi or openmeteo)
AQ_PROVIDER=waqi
WAQI_API_TOKEN=your_waqi_api_token_here

# Security & Logging
TRUSTED_PROXY_HEADER=x-forwarded-for
CLIENT_IP_SALT=replace_with_at_least_16_char_random_salt
LOG_LEVEL=info
NODE_ENV=development
